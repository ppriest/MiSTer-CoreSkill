# Per-machine settings for every MiSTer arcade core on this machine.
# Copy to ~/.mister-core.env (or point MISTER_CORE_ENV at it). The environment
# overrides it. This file lives outside every repository.
#
# A core that differs from the machine gets its own keys, <core>.<KEY>=value, where
# <core> is the repository name without Arcade- and _MiSTer. They win over the
# plain keys. Write them with the MCP server's core_settings_set, e.g.:
#Gaelco3D.MAME_DIR=E:/MAME-Checkouts/mame-gaelco3d
#Gaelco3D.MAME_EXE=gaelco3d.exe

# Where cores are cloned, and the GitHub account that owns them.
# Defaults: the parent of the skill repository, and the signed-in gh account.
MISTER_CORES_ROOT=E:/
MISTER_CORE_OWNER=your-github-user

# Toolchain. QUARTUS_BIN and MODELSIM_BIN are probed if unset; MSYS2_ROOT only
# matters on Windows, where Verilator comes from MSYS2 MinGW64.
QUARTUS_BIN=C:/intelFPGA_lite/17.0/quartus/bin64
MODELSIM_BIN=C:/intelFPGA_lite/17.0/modelsim_ase/win32aloem
MSYS2_ROOT=C:/msys64

# MAME: a build of MAME master, and the master checkout it was built from.
MAME_DIR=C:/path/to/MAME
MAME_EXE=mame.exe
MAME_SRC=C:/path/to/mame/src/mame
# Extra ROM directories (';'-separated), after <core>/roms and MAME_DIR/mame.ini's rompath.
#MAME_ROMPATH=

# The MiSTer on the LAN. A dev board on a local network with the stock
# password: keep it here, out of every repository.
MISTER_HOST=192.168.1.100
MISTER_USER=root
MISTER_PASSWORD=1
